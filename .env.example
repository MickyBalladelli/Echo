# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo
CLIENT_ORIGIN=http://localhost:5000
# Optional comma-separated trusted browser origins
# CLIENT_ORIGINS=http://localhost:5000,http://localhost:5173
LOG_LEVEL=info
DB_QUERY_TIMEOUT_MS=5000
DB_CONNECTION_TIMEOUT_MS=5000
DB_PROFILE_SLOW_MS=250
MAX_JSON_BODY_BYTES=2097152
MAX_SOCKET_BUFFER_BYTES=2097152
SHUTDOWN_TIMEOUT_MS=10000

# Frontend
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
