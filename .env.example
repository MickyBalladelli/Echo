# Backend
NODE_ENV=development
PORT=3000
# Database dialect: postgres (default), sqlite (local file), or turso (Turso/libSQL).
# Use postgres locally and turso in deployment without changing any code:
#   local:  DB_DIALECT=sqlite SQLITE_PATH=./data/echo.sqlite
#   turso:  DB_DIALECT=turso TURSO_URL=libsql://your-db.turso.io TURSO_AUTH_TOKEN=...
DB_DIALECT=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo
# Local SQLite file used when DB_DIALECT=sqlite. Supports ./relative paths
# (resolved from the server working directory) or file:/absolute/path.db.
SQLITE_PATH=./data/echo.sqlite
# Turso connection used when DB_DIALECT=turso. TURSO_AUTH_TOKEN is required
# for remote databases; local `sqld` replicas accept a URL without a token.
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
CLIENT_ORIGIN=http://localhost:5173
# Optional GIPHY API key for live GIF search. Built-in GIFs remain available without it.
# GIPHY_API_KEY=
# Optional OAuth login providers. Leave blank to hide OAuth buttons.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback
# Optional comma-separated trusted browser origins
# CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
DB_QUERY_TIMEOUT_MS=5000
DB_CONNECTION_TIMEOUT_MS=5000
DB_PROFILE_SLOW_MS=250
MAX_JSON_BODY_BYTES=2097152
MAX_SOCKET_BUFFER_BYTES=2097152
SHUTDOWN_TIMEOUT_MS=10000

# Frontend
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
